{
  "name": "@neuxbot/bloub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent avatar geometry, expressions, motion and NeuxBot materials.",
  "license": "MIT",
  "author": "Jérémy Perret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JieWaZi/bloub.git"
  },
  "packageManager": "pnpm@10.34.4",
  "exports": {
    "./engine": "./neuxbot/src/bot/engine.ts",
    "./expressions": "./neuxbot/src/bot/expressions.ts",
    "./skins": "./neuxbot/src/bot/skins.ts",
    "./states": "./neuxbot/src/bot/states.ts",
    "./motion": "./neuxbot/src/plush/motion.ts",
    "./plush-catalogue": "./neuxbot/src/plush/catalogue.ts",
    "./tint": "./neuxbot/src/plush/tint.ts",
    "./drawing": "./neuxbot/src/materials/drawing.ts",
    "./materials": "./neuxbot/src/materials/catalogue.ts",
    "./effects": "./neuxbot/src/materials/effects.ts",
    "./eyes": "./neuxbot/src/materials/eyes.ts",
    "./warp": "./neuxbot/src/materials/warp.ts",
    "./assets/*": "./neuxbot/materials/*",
    "./LICENSE": "./neuxbot/LICENSE",
    "./LICENSE.dsh-bloub-mood": "./neuxbot/LICENSE.dsh-bloub-mood",
    "./upstream.json": "./neuxbot/upstream.json",
    "./expressions-source.json": "./neuxbot/expressions-source.json",
    "./package.json": "./package.json"
  },
  "files": [
    "neuxbot/src",
    "neuxbot/materials",
    "neuxbot/LICENSE",
    "neuxbot/LICENSE.dsh-bloub-mood",
    "neuxbot/upstream.json",
    "neuxbot/expressions-source.json",
    "neuxbot/README.md"
  ],
  "scripts": {
    "materials:generate": "node neuxbot/tools/generate-particle-atlas.mjs",
    "materials:check": "node neuxbot/tools/generate-particle-atlas.mjs --check",
    "test": "vitest run --config neuxbot/vitest.config.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "4.1.10"
  }
}
